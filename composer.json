{
    "name": "schachbulle/contao-contentbox-bundle",
    "type": "contao-bundle",
    "description": "Inhaltselement, das andere Inhaltselemente in einer gestaltbaren Box zusammenfasst.",
    "keywords": [
        "contao",
        "inhaltselement",
        "box",
        "layout"
    ],
    "homepage": "https://github.com/Samson1964/contao-contentbox-bundle",
    "license": "LGPL-3.0-or-later",
    "authors": [
        {
            "name": "Frank Hoppe",
            "homepage": "https://www.schachbulle.de/"
        }
    ],
    "require": {
        "php": "^7.4 || ^8.0",
        "contao/core-bundle": "^4.13 || ^5.0",
        "menatwork/contao-multicolumnwizard-bundle": "^3.6 || ^4.0"
    },
    "conflict": {
        "contao/core": "*",
        "contao/manager-plugin": "<2.0 || >=3.0"
    },
    "require-dev": {
        "contao/manager-plugin": "^2.0"
    },
    "extra": {
        "contao-manager-plugin": "Schachbulle\\ContaoContentboxBundle\\ContaoManager\\Plugin"
    },
    "autoload": {
        "psr-4": {
            "Schachbulle\\ContaoContentboxBundle\\": "src/"
        }
    },
    "support": {
        "issues": "https://github.com/Samson1964/contao-contentbox-bundle/issues",
        "source": "https://github.com/Samson1964/contao-contentbox-bundle"
    }
}
